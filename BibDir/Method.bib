@incollection{fishkin_family_1984,
	series = {{ACM} {Conferences}},
	title = {A family of new algorithms for soft filling},
	isbn = {978-0-89791-138-2},
	url = {https://dl.acm.org/doi/10.1145/800031.808604},
	abstract = {Soft filling algorithms change the color of an anti-aliased region, maintaining the anti-aliasing of the region. The two published algorithms for soft filling work only if the foreground region is anti-aliased against a black background. This paper presents three new algorithms. The first fills against a region consisting of any two distinct colors, and is faster than the published algorithms on a pixel-by-pixel basis for an RGB frame buffer; the second fills against a region composed of three distinct colors; and the third fills against a region composed of four distinct colors. As the power of the algorithms increases, so do the number of assumptions they make, and the computational cost.},
	urldate = {2025-09-21},
	booktitle = {Proceedings of the 11th annual conference on {Computer} graphics and interactive techniques},
	author = {Fishkin, Kenneth P. and Barsky, Brian A.},
	month = jan,
	year = {1984},
	doi = {10.1145/800031.808604},
	keywords = {Convex hull, Linear algebra},
	pages = {235--244},
	file = {Full Text PDF:files/1092/Fishkin和Barsky - 1984 - A family of new algorithms for soft filling.pdf:application/pdf},
}

@incollection{lieberman_how_1978,
	series = {{ACM} {Conferences}},
	title = {How to color in a coloring book},
	isbn = {978-1-4503-7908-3},
	url = {https://dl.acm.org/doi/10.1145/800248.807380},
	abstract = {Children's coloring books contain line drawings which a child can fill in with a crayon to produce colored pictures. Two dimensional colored areas can be produced on a raster display by an analogous method. After drawing a closed curve with line drawing commands, the graphics system can fill the area bordered by the curve. This paper presents an algorithm for filling in areas of any size or shape. The area may be filled with any color, texture, or “wallpaper” pattern. The algorithm is simple, flexible and efficient, optimized to take advantage of the the memory organization of most current raster graphics systems.},
	urldate = {2025-09-21},
	booktitle = {Proceedings of the 5th annual conference on {Computer} graphics and interactive techniques},
	author = {Lieberman, Henry},
	month = aug,
	year = {1978},
	doi = {10.1145/800248.807380},
	keywords = {flooding) closed curves raster graphics, Shading (or filling},
	pages = {111--116},
	file = {Full Text PDF:files/1094/Lieberman - 1978 - How to color in a coloring book.pdf:application/pdf},
}
