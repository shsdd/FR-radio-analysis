ADS Bibcode: 1984ApJ...278...37E},
	keywords = {Astrophysics, Intergalactic Media, Galactic Structure, Hubble Constant, X Ray Astronomy, Euler Equations Of Motion, Galactic Clusters, Galactic Radio Waves, Lorentz Force, Radio Astronomy, X Ray Sources},
	pages = {37--50},
