	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Cotton, W. D. and Thorat, K. and Condon, J. J. and Frank, B. S. and Józsa, G. I. G. and White, S. V. and Deane, R. and Oozeer, N. and Atemkeng, M. and Bester, L. and Fanaroff, B. and Kupa, R. S. and Smirnov, O. M. and Mauch, T. and Krishnan, V. and Camilo, F.},
	month = jun,
	year = {2020},
	note = {arXiv:2005.02723 [astro-ph]},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	pages = {1271--1283},
