@article{boyce_hydra_2023-1,
	title = {Hydra {II}: {Characterisation} of {Aegean}, {Caesar}, {ProFound}, {PyBDSF}, and {Selavy} source finders},
	volume = {40},
	issn = {1323-3580},
	shorttitle = {Hydra {II}},
	url = {https://ui.adsabs.harvard.edu/abs/2023PASA...40...27B},
	doi = {10.1017/pasa.2023.29},
	abstract = {We present a comparison between the performance of a selection of source finders (SFs) using a new software tool called Hydra. The companion paper, Paper I, introduced the Hydra tool and demonstrated its performance using simulated data. Here we apply Hydra to assess the performance of different source finders by analysing real observational data taken from the Evolutionary Map of the Universe (EMU) Pilot Survey. EMU is a wide-field radio continuum survey whose primary goal is to make a deep ( \$20{\textbackslash}mu\$ Jy/beam RMS noise), intermediate angular resolution ( \$15{\textasciicircum}\{{\textbackslash}prime{\textbackslash}prime\}\$ ), 1 GHz survey of the entire sky south of \$+30{\textasciicircum}\{{\textbackslash}circ\}\$ declination, and expecting to detect and catalogue up to 40 million sources. With the main EMU survey it is highly desirable to understand the performance of radio image SF software and to identify an approach that optimises source detection capabilities. Hydra has been developed to refine this process, as well as to deliver a range of metrics and source finding data products from multiple SFs. We present the performance of the five SFs tested here in terms of their completeness and reliability statistics, their flux density and source size measurements, and an exploration of case studies to highlight finder-specific limitations.},
	urldate = {2025-09-30},
	journal = {Publications of the Astronomical Society of Australia},
	author = {Boyce, M. M. and Hopkins, A. M. and Riggi, S. and Rudnick, L. and Ramsay, M. and Hale, C. L. and Marvil, J. and Whiting, M. T. and Venkataraman, P. and O'Dea, C. P. and Baum, S. A. and Gordon, Y. A. and Vantyghem, A. N. and Dionyssiou, M. and Andernach, H. and Collier, J. D. and English, J. and Koribalski, B. S. and Leahy, D. and Michałowski, M. J. and Safi-Harb, S. and Vaccari, M. and Alexander, E. L. and Cowley, M. and Kapinska, A. D. and Robotham, A. S. G. and Tang, H.},
	month = jul,
	year = {2023},
	note = {ADS Bibcode: 2023PASA...40...27B},
	keywords = {Astrophysics - Instrumentation and Methods for Astrophysics, D.2.8},
	pages = {e027},
