@article{mcnamara_energetic_2009,
	title = {An {Energetic} {AGN} {Outburst} {Powered} by a {Rapidly} {Spinning} {Supermassive} {Black} {Hole} or an {Accreting} {Ultramassive} {Black} {Hole}},
	volume = {698},
	issn = {0004-637X, 1538-4357},
	url = {http://arxiv.org/abs/0811.3020},
	doi = {10.1088/0004-637X/698/1/594},
	abstract = {Powering the 10{\textasciicircum}62 erg nuclear outburst in the MS0735.6+7421 cluster central galaxy by accretion implies that its supermassive black hole (SMBH) grew by {\textasciitilde}6x10{\textasciicircum}8 solar masses over the past 100 Myr. We place upper limits on the amount of cold gas and star formation near the nucleus of {\textless}10{\textasciicircum}9 solar masses and {\textless}2 solar masses per year, respectively. These limits imply that an implausibly large fraction of the preexisting cold gas in the bulge must have been consumed by its SMBH at the rate of {\textasciitilde}3-5 solar masses per year while leaving no trace of star formation. Such a high accretion rate would be difficult to maintain by stellar accretion or the Bondi mechanism, unless the black hole mass approaches 10{\textasciicircum}11 solar masses. Its feeble nuclear luminosities in the UV, I, and X-ray bands compared to its enormous mechanical power are inconsistent with rapid accretion onto a {\textasciitilde}5x10{\textasciicircum}9 solar mass black hole. We suggest instead that the AGN outburst is powered by a rapidly-spinning black hole. A maximally-spinning, 10{\textasciicircum}9 solar mass black hole contains enough rotational energy, {\textasciitilde}10{\textasciicircum}62 erg, to quench a cooling flow over its lifetime and to contribute significantly to the excess entropy found in the hot atmospheres of groups and clusters. Two modes of AGN feedback may be quenching star formation in elliptical galaxies centered in cooling halos at late times. An accretion mode that operates in gas-rich systems, and a spin mode operating at modest accretion rates. The spin conjecture may be avoided in MS0735 by appealing to Bondi accretion onto a central black hole whose mass greatly exceeds 10{\textasciicircum}10 solar mass. The host galaxy's unusually large, 3.8 kpc stellar core radius (light deficit) may witness the presence of an ultramassive black hole.},
	language = {en-US},
	number = {1},
	urldate = {2025-06-21},
	journal = {The Astrophysical Journal},
	author = {McNamara, B. R. and Kazemzadeh, F. and Rafferty, D. A. and Birzan, L. and Nulsen, P. E. J. and Kirkpatrick, C. C. and Wise, M. W.},
	month = jun,
	year = {2009},
	note = {arXiv:0811.3020 [astro-ph]},
	keywords = {Astrophysics},
	pages = {594--605},
	file = {Full Text PDF:C\:\\Users\\ryma\\Zotero\\storage\\GPZIBTLE\\McNamara 等 - 2009 - An Energetic AGN Outburst Powered by a Rapidly Spinning Supermassive Black Hole or an Accreting Ultr.pdf:application/pdf;Snapshot:files/583/0811.html:text/html},
}

@article{perucho_numerical_2007,
	title = {A numerical simulation of the evolution and fate of a {Fanaroff}-{Riley} type {I} jet. {The} case of {3C} 31},
	volume = {382},
	issn = {0035-8711},
	url = {https://ui.adsabs.harvard.edu/abs/2007MNRAS.382..526P},
	doi = {10.1111/j.1365-2966.2007.12454.x},
	abstract = {The evolution of Fanaroff-Riley type I (FRI) jets has long been studied in the framework of the FRI-FRII dichotomy. The present paradigm consists of the expansion of overpressured jets in the ambient medium and the generation of standing recollimation shocks, followed by mass entrainment from the external medium that decelerates the jets to subsonic speeds. In this paper, we test the present theoretical and observational models via a relativistic numerical simulation of the jets in the radio galaxy 3C 31. We use the parameters derived from the modelling presented by Laing \& Bridle as input parameters for the simulation of the evolution of the source, thus assuming that they have not varied over the lifetime of the source. We simulate about 10 per cent of the total lifetime of the jets in 3C 31. Realistic density and pressure gradients for the atmosphere are used. The simulation includes an equation of state for a two-component relativistic gas that allows a separate treatment of leptonic and baryonic matter. We compare our results with the modelling of the observational data of the source. Our results show that the bow shock evolves self-similarly at a quasi-constant speed, with slight deceleration by the end of the simulation, in agreement with recent X-ray observations that show the presence of bow shocks in FRI sources. The jet expands until it becomes underpressured with respect to the ambient medium, and then recollimates. Subsequent oscillations around pressure equilibrium and generation of standing shocks lead to the mass-loading and disruption of the jet flow. We derive an estimate for the minimum age of the source of t {\textgreater} 1 × 108yr, which may imply continuous activity of 3C 31 since the triggering of its activity. The simulation shows that weak compact steep spectrum sources may be the young counterparts of FRI sources. We conclude that the observed properties of the jets in 3C 31 are basically recovered by the standing shock scenario.},
	urldate = {2025-07-23},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Perucho, M. and Martí, J. M.},
	month = dec,
	year = {2007},
	note = {Publisher: OUP
ADS Bibcode: 2007MNRAS.382..526P},
	keywords = {Astrophysics, galaxies: active, galaxies: individual: 3C 31, galaxies: jets, galaxies: nuclei, radio continuum: galaxies},
	pages = {526--542},
	file = {Full Text PDF:C\:\\Users\\ryma\\Zotero\\storage\\LU3TCPK2\\Perucho和Martí - 2007 - A numerical simulation of the evolution and fate of a Fanaroff-Riley type I jet. The case of 3C 31.pdf:application/pdf},
}

@article{laing_dynamical_2002,
	title = {Dynamical models for jet deceleration in the radio galaxy {3C} 31},
	volume = {336},
	issn = {0035-8711},
	url = {https://ui.adsabs.harvard.edu/abs/2002MNRAS.336.1161L},
	doi = {10.1046/j.1365-8711.2002.05873.x},
	abstract = {We present a dynamical analysis of the flow in the jets of the low-luminosity radio galaxy 3C 31 based on our earlier geometrical and kinematic model and on estimates of the external pressure and density distributions from Chandra observations. We apply conservation of particles, energy and momentum to derive the variations of pressure and density along the jets and show that there are self-consistent solutions for deceleration by injection of thermal matter. We initially take the jets to be in pressure equilibrium with the external medium at large distances from the nucleus and the momentum flux to be Π=Φ/c, where Φ is the energy flux; we then progressively relax these constraints. With our initial assumptions, the energy flux is well determined: Φ{\textasciitilde} 9-14 × 1036 W. We infer that the jets are overpressured compared with the external medium at the flaring point (1.1 kpc from the nucleus) where they start to expand rapidly. Local minima in the density and pressure and maxima in the mass injection rate and Mach number occur at {\textasciitilde}3 kpc. Further out, the jets decelerate smoothly with a Mach number of {\textasciitilde}1. The mass injection rate we infer is comparable with that expected from stellar mass loss throughout the cross-section of the jet close to the flaring point, but significantly exceeds it at large distances. We conclude that entrainment from the galactic atmosphere across the turbulent boundary layer of the jet is the dominant mass input process far from the nucleus, but that stellar mass loss may also contribute near the flaring point. The occurrence of a significant overpressure at the flaring point leads us to suggest that it is the site of a stationary shock system, perhaps caused by reconfinement of an initially free jet. Our results are compatible with a jet consisting of e-e+ plasma on parsec scales that picks up thermal matter from stellar mass loss to reach the inferred density and mass flux at the flaring point, but we cannot rule out an e-p+ composition with a low-energy cut-off.},
	urldate = {2025-07-23},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Laing, R. A. and Bridle, A. H.},
	month = nov,
	year = {2002},
	note = {Publisher: OUP
ADS Bibcode: 2002MNRAS.336.1161L},
	keywords = {Astrophysics, galaxies: jets, radio continuum: galaxies, galaxies: individuals: 3C 31, galaxies: ISM, hydrodynamics, X-rays: galaxies},
	pages = {1161--1180},
	file = {Full Text PDF:C\:\\Users\\ryma\\Zotero\\storage\\QIWXQU5T\\Laing和Bridle - 2002 - Dynamical models for jet deceleration in the radio galaxy 3C 31.pdf:application/pdf},
}

@article{de_young_relation_1993,
	title = {On the {Relation} between {Fanaroff}-{Riley} {Types} {I} and {II} {Radio} {Galaxies}},
	volume = {405},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/1993ApJ...405L..13D},
	doi = {10.1086/186754},
	abstract = {Recent optical observations of radio galaxies reveal a transition from F-R II morphology to F-R I morphology with increasing optical luminosity at fixed radio luminosity. This transition can occur if a highly supersonic jet which normally fuels F-R II sources is instead strongly decelerated near the nucleus, producing the transonic or subsonic flow which gives rise to the F-R I morphology at the same radio power. It is shown that this deceleration can occur if the more optically luminous galaxies possess a dense inner ISM core, with an average density of order 10 cm{\textasciicircum}-3{\textasciicircum} and a radius of order 1 kpc. The turbulent boundary layer of the high Reynolds number jet passing through this core entrains the ISM and imparts momentum to it, causing the jet to decelerate. A search of available photometry for these galaxies shows no significant color differences in B - V between the F-R I and F-R II objects, but a larger sample with emphasis on photometry of the nuclear region is required before any definitive conclusions can be drawn about differences in color.},
	urldate = {2025-07-23},
	journal = {The Astrophysical Journal},
	author = {De Young, David S.},
	month = mar,
	year = {1993},
	note = {Publisher: IOP
ADS Bibcode: 1993ApJ...405L..13D},
	keywords = {Astrophysics, GALAXIES: JETS, Radio Galaxies, Radio Jets (Astronomy), Active Galaxies, Boundary Layers, Deceleration, Galactic Evolution, Galactic Nuclei, Galactic Structure, GALAXIES: ACTIVE, Luminosity, Photometry, RADIO CONTINUUM: GALAXIES, Stellar Color, TURBULENCE},
	pages = {L13},
	file = {Full Text PDF:C\:\\Users\\ryma\\Zotero\\storage\\JGEUBACL\\De Young - 1993 - On the Relation between Fanaroff-Riley Types I and II Radio Galaxies.pdf:application/pdf},
}

