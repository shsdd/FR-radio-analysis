	note = {ADS Bibcode: 2012MNRAS.423.2518C},
	keywords = {dark ages, first stars, reionization, cosmology: theory, diffuse radiation, Astrophysics - Cosmology and Extragalactic Astrophysics, methods: statistical},
	pages = {2518--2532},
	file = {已提交版本:files/1070/Chapman 等 - 2012 - Foreground removal using FASTICA a showcase of LOFAR-EoR.pdf:application/pdf},
}

