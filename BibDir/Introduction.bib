@misc{mtshweni_hi_2025,
	title = {{HI} gas in the rejuvenated radio galaxy {PKS} 2014-55},
	url = {http://arxiv.org/abs/2508.20276},
	doi = {10.48550/arXiv.2508.20276},
	abstract = {We present new high-spectral-resolution MeerKAT observations of \${\textbackslash}mathrm\{HI\}\$ absorption against the central region of the restarted, giant, X-shaped radio galaxy PKS2014-55, which exhibits morphological evidence of three distinct cycles of activity. We report a wide component \$({\textbackslash}mathrm\{FWHM\}=38 {\textbackslash}pm 7{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\})\$ redshifted to \$96 {\textbackslash}pm 50{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\}\$, a deep narrow detection \$({\textbackslash}mathrm\{FWHM\}=19 {\textbackslash}pm 6{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\})\$ redshifted to \$160 {\textbackslash}pm 40{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\}\$, and a shallow component \$({\textbackslash}mathrm\{FWHM\}=22 {\textbackslash}pm 6{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\})\$ redshifted to \$240 {\textbackslash}pm 40{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\}\$. One of the three components exceeds the typical rotational velocity of \$100{\textasciitilde}{\textbackslash}mathrm\{kms{\textasciicircum}\{-1\}\}\$, suggesting complex kinematics of the inflowing gas. These \${\textbackslash}mathrm\{HI\}\$ observations support the correlation between the occurrence of \${\textbackslash}mathrm\{HI\}\$ absorption and the rejuvenation of radio activity.},
