Volume: 348
ADS Bibcode: 1999A\&A...348..699L},
	keywords = {Astrophysics, GALAXIES: JETS, GALAXIES: ACTIVE, RADIO CONTINUUM: GALAXIES, GALAXIES: INDIVIDUAL: J1835+620},
	file = {Full Text PDF:files/1173/Lara 等 - 1999 - Restarting activity in the giant radio galaxy J1835+620.pdf:application/pdf},
}

@inproceedings{gupta_machine_2025,
